# Local-First Financial Agent (LFFA) — environment template
# Copy to .env and adjust. Prefer LFFA_* names; legacy aliases noted below.
# Full reference: README.md and src/lffa/config.py

# -----------------------------------------------------------------------------
# Data paths
# -----------------------------------------------------------------------------
# Directory for local state (used when LFFA_LEDGER_DB is unset)
LFFA_DATA_DIR=./.lffa
# SQLite ledger file (local-first system of record)
LFFA_LEDGER_DB=./.lffa/ledger.db

# -----------------------------------------------------------------------------
# Inference routing
# -----------------------------------------------------------------------------
# Character budget for on-device SLM before marking nosana_overflow
LFFA_LOCAL_MAX_CONTEXT_CHARS=4000
# Set to 1 / true / yes to never route to overflow (demo on airplane Wi‑Fi)
LFFA_FORCE_LOCAL=0

# -----------------------------------------------------------------------------
# Local SLM (Ollama) — optional; stub fallback if unreachable
# Install: https://ollama.com/ then: ollama pull llama3.2:1b
# -----------------------------------------------------------------------------
LFFA_OLLAMA_BASE_URL=http://127.0.0.1:11434
LFFA_OLLAMA_MODEL=llama3.2:1b

# -----------------------------------------------------------------------------
# Nosana decentralized GPU overflow
# Claim hackathon credits: docs/nosana-credits.md
# API docs: https://learn.nosana.com/api/intro.html
# -----------------------------------------------------------------------------
# Bearer token (either name works; LFFA_* is preferred)
LFFA_NOSANA_API_KEY=
NOSANA_API_KEY=
LFFA_NOSANA_API_BASE=https://api.nosana.com
# Optional: post a real job (requires IPFS-pinned job definition — spends credits)
NOSANA_IPFS_HASH=
NOSANA_MARKET=97G9NnvBDQ2WpKu6fasoMsAKmfj63C9rhysJnkeWodAf
NOSANA_JOB_TIMEOUT=600
NOSANA_JOB_TEMPLATE_ID=

# -----------------------------------------------------------------------------
# Arweave provenance (hash always; on-chain upload not implemented in LFFA yet)
# https://www.arweave.org/
# -----------------------------------------------------------------------------
LFFA_ARWEAVE_GATEWAY_URL=https://arweave.net
LFFA_ARWEAVE_WALLET_JWK_PATH=
# Legacy aliases (same behavior as LFFA_* above)
ARWEAVE_GATEWAY_URL=https://arweave.net
ARWEAVE_WALLET_JWK_PATH=

# -----------------------------------------------------------------------------
# CLI display
# -----------------------------------------------------------------------------
# Set to 1 to disable ANSI colors even on a TTY (also respects NO_COLOR)
# LFFA_NO_COLOR=0
